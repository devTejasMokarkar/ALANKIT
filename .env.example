APP_ENV=development
PORT=8081
HOST=localhost
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=AlankitUserDetails_Development
# Maximum simultaneous registrations per Node process, including work after client disconnect.
REGISTRATION_MAX_INFLIGHT=200
# 0 disables the optional per-process rate cap. Excess requests receive 429.
REGISTRATION_RATE_LIMIT_RPS=0
MONGO_MAX_POOL_SIZE=100

# Used only by diagnostics/load-test.cjs
LOAD_TEST_LOGO_URL=
LOAD_TEST_PASSWORD=load-test-only-password
