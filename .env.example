APP_ENV=development
PORT=8081
HOST=localhost
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=AlankitUserDetails_Development
# Maximum simultaneous registrations per Node process, including work after client disconnect.
REGISTRATION_MAX_INFLIGHT=200
# 0 disables the optional per-process rate cap. Excess requests receive 429.
REGISTRATION_RATE_LIMIT_RPS=0
MONGO_MAX_POOL_SIZE=100

# Used only by diagnostics/load-test.cjs
LOAD_TEST_LOGO_URL=
LOAD_TEST_PASSWORD=load-test-only-password

# Server-side Cloudinary invoice storage (required for invoice generation).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Alternative to the three values above: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# CLOUDINARY_URL=

# Maximum simultaneous invoice generation operations per Node process.
INVOICE_MAX_INFLIGHT=64

# PDF generation uses reusable worker threads, leaving the API event loop available.
# Default worker count: up to 4, reserving one available CPU when possible.
INVOICE_PDF_WORKERS=4
INVOICE_PDF_MAX_QUEUE=64
INVOICE_PDF_TIMEOUT_MS=30000
